Cell[BoxData[
    RowBox[{
      RowBox[{"(*", " ", 
        StyleBox[\(Take\ the\ derivative\),
          FontSlant->"Italic"], " ", "*)"}], 
      "\[IndentingNewLine]", \(dgdx[a_, x_] := 
          Simplify[\ 
            D[\ relEntropy[\ q[a, u, u], \ p], \ u]\ \  /. \ 
              u \[Rule] x\ \ ];\)}]], "Input"],

Cell[CellGroupData[{

Cell[BoxData[
    \(\(\(dgdx[3, x]\)\(\ \)\)\)], "Input"],

Cell[BoxData[
    \(1\/2\ \((Log[256\/27] - 4\ Log[1 - 2\ x] + 4\ Log[x])\)\)], "Output"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
    RowBox[{
      RowBox[{"(*", " ", 
        StyleBox[\(Get\ the\ minimum\ by\ setting\ the\ derivative\ to\ \
zero\),
          FontSlant->"Italic"], 
        StyleBox[" ",
          FontSlant->"Italic"], "*)"}], 
      "\[IndentingNewLine]", \(xmin = \ 
        Simplify[\ \ Solve[\ dgdx[3, x] \[Equal] 0, \ x\ ]\ ]\)}]], "Input"],

Cell[BoxData[
    \({{x \[Rule] 3\/\(6 + 4\ 3\^\(1/4\)\)}}\)], "Output"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
    \(xmin // \ N\)], "Input"],

Cell[BoxData[
    \({{x \[Rule] 0.266328227365611`}}\)], "Output"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
    RowBox[{
      RowBox[{"(*", 
        StyleBox[\(In\ \(\(general\)\(:\)\)\),
          FontSlant->"Italic"], " ", "*)"}], 
      "\[IndentingNewLine]", \(dgdx[\ a, x]\  // \ Simplify\)}]], "Input"],

Cell[BoxData[
    \(\(-\(\(2\ \((Log[\(4 - 8\ x\)\/\(1 + a\)] + 
                a\ Log[\(a\ \((4 - 8\ x)\)\)\/\(1 + a\)] - \((1 + a)\)\ Log[
                    4\ x])\)\)\/\(1 + a\)\)\)\)], "Output"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
    RowBox[{
      RowBox[{"(*", " ", 
        StyleBox[\(As\ a\ increases, \ xmin\ goes\ from\ 1/4\ to\ 1/3\),
          FontSlant->"Italic"], " ", "*)"}], 
      "\[IndentingNewLine]", \(Table[\ {a, \ 
            NSolve[dgdx[a, x] \[Equal] 0, x]}, \ {a, 1, 10}]\  // \ 
        MatrixForm\)}]], "Input"],

Cell[BoxData[
    TagBox[
      RowBox[{"(", "\[NoBreak]", GridBox[{
            {"1", \({{x \[Rule] 0.25`}}\)},
            {"2", \({{x \[Rule] 0.2570772350673783`}}\)},
            {"3", \({{x \[Rule] 0.266328227365611`}}\)},
            {"4", \({{x \[Rule] 0.2740187814008055`}}\)},
            {"5", \({{x \[Rule] 0.2801754112969329`}}\)},
            {"6", \({{x \[Rule] 0.28514456152188455`}}\)},
            {"7", \({{x \[Rule] 0.289220525566382`}}\)},
            {"8", \({{x \[Rule] 0.29261916316105496`}}\)},
            {"9", \({{x \[Rule] 0.29549556997756765`}}\)},
            {"10", \({{x \[Rule] 0.29796211078368323`}}\)}
            }], "\[NoBreak]", ")"}],
      Function[ BoxForm`e$, 
        MatrixForm[ BoxForm`e$]]]], "Output"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
    \(\(\(\ \)\(NSolve[dgdx[100, x] \[Equal] 0, x]\)\)\)], "Input"],

Cell[BoxData[
    \({{x \[Rule] 0.3271054930264108`}}\)], "Output"]
}, Open  ]],

