Notebook[{
Cell[BoxData[
    RowBox[{
      RowBox[{"(*", " ", 
        StyleBox[\(\(JudyBenjaminEntropy . \(nb\  : \ 
                  See\ Grove\)\  &\)\ Halpern\ 1997\),
          FontSlant->"Italic"], " ", "*)"}], "\[IndentingNewLine]"}]], "Input"],

Cell[BoxData[
    RowBox[{
      RowBox[{"(*", " ", 
        StyleBox[\(Relative\ entropy\ of\ q\ with\ respect\ to\ p\),
          FontSlant->"Italic"], " ", "*)"}], 
      "\[IndentingNewLine]", \(relEntropy[\ q_, p_] := \ 
        Plus\  @@ \ \((\ q\ Log[\ q\/p])\)\)}]], "Input"],

Cell[BoxData[
    RowBox[{
      RowBox[{"(*", " ", 
        RowBox[{
          RowBox[{
            StyleBox["Prior",
              FontSlant->"Italic"], 
            StyleBox[" ",
              FontSlant->"Italic"], 
            StyleBox["Probability",
              FontSlant->"Italic"], " ", 
            StyleBox["p",
              FontSlant->"Italic"]}], 
          StyleBox["=",
            FontSlant->"Italic"], 
          StyleBox[" ",
            FontSlant->"Italic"], 
          
          StyleBox[\({\ Pr[Blue2nd], \ Pr[BlueHQ], \ Pr[Red2nd], \ 
              Pr[RedHQ]\ }\),
            FontSlant->"Italic"]}], 
        StyleBox[" ",
          FontSlant->"Italic"], "*)"}], " ", 
      "\[IndentingNewLine]", \(p = \ {1/4, \ 1/4, \ 1/4, \ 
            1/4}\ ;\)}]], "Input"],

Cell[BoxData[
    RowBox[{
      RowBox[{"(*", " ", 
        RowBox[{
          StyleBox["Set",
            FontSlant->"Italic"], 
          StyleBox[" ",
            FontSlant->"Italic"], 
          StyleBox["of",
            FontSlant->"Italic"], 
          StyleBox[" ",
            FontSlant->"Italic"], 
          StyleBox["possible",
            FontSlant->"Italic"], 
          StyleBox[" ",
            FontSlant->"Italic"], 
          StyleBox["probabilities",
            FontSlant->"Italic"], 
          StyleBox[" ",
            FontSlant->"Italic"], 
          StyleBox["consistent",
            FontSlant->"Italic"], 
          StyleBox[" ",
            FontSlant->"Italic"], 
          StyleBox["with",
            FontSlant->"Italic"], 
          StyleBox[" ",
            FontSlant->"Italic"], 
          StyleBox["new",
            FontSlant->"Italic"], 
          StyleBox[" ",
            FontSlant->"Italic"], 
          RowBox[{
            StyleBox["evidence",
              FontSlant->"Italic"], 
            StyleBox[":",
              FontSlant->"Italic"], "\[IndentingNewLine]", 
            
            StyleBox[\(Odds\ are\ \(a : 
                  1\ that\ if\ she\ is\ in\ Red\ then\ she\ is\ in\ RedHQ\)\),
              
              FontSlant->"Italic"]}]}], 
        StyleBox[" ",
          FontSlant->"Italic"], "*)"}], 
      "\[IndentingNewLine]", \(q[a_, x_, y_] := \ {x, \ 
            y, \ \(1\/\(1 + a\)\) \((1 - x - y)\), \ \(a\/\(1 + a\)\) \((1 - 
                  x - y)\)\ }\ ;\)}]], "Input"],

Cell[BoxData[
    \(\(\(\[IndentingNewLine]\)\( (*\ 
      Function\ of\ \((x, 
          y)\)\ to\ be\ minimized\ \((parametrized\ by\ odds\ a)\)\ *) \)\(\
\[IndentingNewLine]\)\(f[a_, x_, y_] := \ \[IndentingNewLine]If[\ 
          x\  > \ 0\ \  && \ \ y\  > \ 0\ \  && \ \ x + y\  < \ 
              1, \[IndentingNewLine]relEntropy[\ q[a, x, y], \ 
            p], \[IndentingNewLine]\(-1\)\ ]\ ;\)\)\)], "Input"],

Cell[CellGroupData[{

Cell[BoxData[
    RowBox[{
      RowBox[{"(*", " ", 
        StyleBox[\(The\ x, 
          y\ that\ give\ the\ "\<best\>"\ revised\ probability\ q[x, 
              y]\ should\ be\ at\ the\ minimum\ \ of\ this\ surface\),
          FontSlant->"Italic"], " ", "*)"}], 
      "\[IndentingNewLine]", \(ContourPlot[\ 
          f[3, \ x, y], \ {x, 0, 1}, \ {y, 0, 
            1}, \ \[IndentingNewLine]PlotPoints \[Rule] 200, \ 
          Contours \[Rule] 30, \ 
          ContourShading \[Rule] False]\ ;\)}]], "Input"],

Cell[GraphicsData["PostScript", "\<\
